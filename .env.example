# Copy to .env.local and fill in. Never commit .env.local.

# Supabase Postgres (Project Settings > Database > Connection string, use the pooled URI)
DATABASE_URL=

# Strava API app (https://www.strava.com/settings/api)
STRAVA_CLIENT_ID=
STRAVA_CLIENT_SECRET=
# Random string you choose; used to verify webhook subscription
STRAVA_WEBHOOK_VERIFY_TOKEN=

# 32-byte key, base64 (generate: openssl rand -base64 32). Encrypts Strava tokens at rest.
TOKEN_ENCRYPTION_KEY=

# Random string; Vercel cron sends it as Authorization: Bearer <CRON_SECRET>
CRON_SECRET=

# Public base URL (http://localhost:3000 in dev)
APP_URL=http://localhost:3000
